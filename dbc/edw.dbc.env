#############################################################################
# edw.dbc.env
# Runtime credential resolution for edw.dbc.
# NOTE: real values are injected by the scheduler from the vault; the
# placeholders below are for local/demo runs only.
#############################################################################
export ORACLE_HOME=${ORACLE_HOME:-/opt/oracle/product/19c/dbhome_1}
export EDW_DB_USER=${EDW_DB_USER:-edw_etl_svc}
export EDW_DB_PASSWORD=${EDW_DB_PASSWORD:-__SET_IN_VAULT__}
